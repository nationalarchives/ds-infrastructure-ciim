{
  "#type": "merge",
  "depth": -1,
  "values": [
    "$.current",
    {
      "results": {
        "request": {
          "aggregations": {
            "PA": {
              "filter": {
                "bool": {
                  "must": [
                    {
                      "query_string": {
                        "query": "source.value:UNKNOWN"
                      }
                    },
                    {
                      "prefix": {
                        "@hierarch.identifier.value": "Y"
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
