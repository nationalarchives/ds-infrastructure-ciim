{
  "#type": "merge",
  "depth": -1,
  "values": [
    "$.current",
    {
      "#type": "require",
      "require": "$.original.query[?(@.parliamentaryArchive == 'true')]",
      "value": {
        "results": {
          "request": {
            "query": {
              "bool": {
                "filter": [
                  {
                    "bool": {
                      "must": [
                        {
                          "query_string": {
                            "query": "source.value:UNKNOWN"
                          }
                        },
                        {
                          "prefix": {
                            "@hierarch.identifier.value": "Y"
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}