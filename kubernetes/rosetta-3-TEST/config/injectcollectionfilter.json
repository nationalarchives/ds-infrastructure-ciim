{
  "#type": "chain",
  "chain": [
    {
      "#type": "regex_groups",
      "value": "$.original.query.filter",
      "pattern": "(?:^|;)collection:\\(?(?<collection>[^;)]+)\\)?(?:;|$)",
      "requireMatch": true
    },
    {
      "#type": "string_split",
      "value": "$.collection",
      "delimiter": ","
    }
  ]
}