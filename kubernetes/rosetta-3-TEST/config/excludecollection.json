{
  "#type": "merge",
  "values": [
    "$",
    {
      "original": {
        "#type": "merge",
        "values": [
          "$.original",
          {
            "collectionFilter": "$.current.filters.collection"
          }
        ]
      },
      "current": {
        "#type": "merge",
        "values": [
          "$.current",
          {
            "filters": {
              "#type": "select",
              "value": "$.current.filters",
              "policy": "exclude",
              "keys": "collection"
            }
          }
        ]
      }
    }
  ]
}